    <!-- Pairing -->
    <string name="pair_dialog_title">Pair with your Mac</string>
    <string name="pair_dialog_msg">1. Install PhoneDrop on your Mac and open it.\n\n2. Click the PhoneDrop icon in the Mac\'s menu bar.\n\n3. Tap “Scan code” and point your phone at the QR code.\n\nYour phone and Mac need to be on the same Wi-Fi network.</string>
